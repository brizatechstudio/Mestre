# MESTRE 1.5.3 — configuração de exemplo segura.
# Copie para .env. Nunca coloque service_role, sb_secret_, chave privada ou service account em VITE_*.

# PRÉVIA LOCAL (padrão enquanto o site ainda não foi publicado)
# false = login desativado e nenhum acesso ao Firestore é iniciado.
# Quando for colocar em produção, altere para true e VITE_BACKEND_MODE=firebase.
VITE_LOGIN_ENABLED=false
VITE_BACKEND_MODE=local

# Na prévia local, use pro para testar PDF/voz sem depender de anúncios reais.
# Troque para free se quiser testar também os gates do plano grátis.
VITE_PREVIEW_PLAN=pro

# Produção: use email para a mesma conta funcionar no navegador e no PWA/celular.
# Valores aceitos: email | anonymous
VITE_AUTH_MODE=email

# Firebase Console > Configurações do projeto > Seus apps > App Web > SDK setup/config
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Supabase > Project Settings > Data API / API Keys
# Use apenas a Publishable Key no frontend.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Google Ad Manager > unidades de anúncio.
# Rewarded libera voz/PDF no plano grátis.
VITE_GOOGLE_REWARDED_AD_UNIT_PATH=
# Banner responsivo aparece nas telas internas do plano grátis.
# Enquanto vazio, a prévia mostra um placeholder de publicidade.
VITE_GOOGLE_BANNER_AD_UNIT_PATH=
# true = força o placeholder do banner apenas na prévia local, inclusive com plano pro.
# Antes de publicar, altere para false.
VITE_BANNER_PREVIEW=true

# Checkout do MESTRE Pro. Pode ficar vazio até a integração de pagamentos.
VITE_PRO_CHECKOUT_URL=
