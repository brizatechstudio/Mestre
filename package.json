{
  "name": "mestre-orcamentos",
  "private": true,
  "version": "1.6.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "verify": "npm run doctor && npm run typecheck && npm run build",
    "doctor": "node scripts/doctor.mjs",
    "check:ads": "node scripts/check-ads.mjs",
    "android:sync": "npm run build && cap sync android",
    "android:open": "npm run android:sync && cap open android",
    "android:run": "npm run android:sync && cap run android",
    "android:apk:debug": "npm run android:sync && cd android && gradlew.bat assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.5.0",
    "firebase": "^12.17.1",
    "jspdf": "^4.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "typescript": "^5.9.0",
    "vite": "^8.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "allowScripts": {
    "@firebase/util@1.15.2": true,
    "core-js@3.50.0": true,
    "protobufjs@7.6.5": true
  }
}
