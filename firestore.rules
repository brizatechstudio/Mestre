rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // Perfil-raiz da conta. O próprio profissional pode manter somente o seu documento.
    match /users/{userId} {
      allow read, create, update, delete: if isOwner(userId);
    }

    // Configurações profissionais e preferências da conta.
    match /users/{userId}/settings/{settingsId} {
      allow read, write: if isOwner(userId) && settingsId == 'profile';
    }

    // Dados operacionais privados do profissional.
    match /users/{userId}/clients/{documentId} {
      allow read, write: if isOwner(userId);
    }

    match /users/{userId}/services/{documentId} {
      allow read, write: if isOwner(userId);
    }

    match /users/{userId}/materials/{documentId} {
      allow read, write: if isOwner(userId);
    }

    match /users/{userId}/costs/{documentId} {
      allow read, write: if isOwner(userId);
    }

    match /users/{userId}/quotes/{documentId} {
      allow read, write: if isOwner(userId);
    }

    match /users/{userId}/workOrders/{documentId} {
      allow read, write: if isOwner(userId);
    }

    match /users/{userId}/receipts/{documentId} {
      allow read, write: if isOwner(userId);
    }

    // Contadores transacionais usados para ORC-0001, OS-0001 e REC-0001.
    match /users/{userId}/counters/{counterId} {
      allow read, write: if isOwner(userId)
        && counterId in ['quotes', 'workOrders', 'receipts'];
    }

    // O frontend pode somente ler o plano da própria conta.
    // Alterações devem vir futuramente de um backend/webhook de pagamento confiável.
    match /entitlements/{userId} {
      allow read: if isOwner(userId);
      allow create, update, delete: if false;
    }

    // Qualquer caminho não declarado acima fica bloqueado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
