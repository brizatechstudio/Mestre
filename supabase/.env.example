# MESTRE 1.6.1 — secrets/configuração da Edge Function mestre-storage.
# Copie para supabase/.env somente quando for publicar a Edge Function.

# Deve ser EXATAMENTE o mesmo VITE_FIREBASE_PROJECT_ID do frontend.
FIREBASE_PROJECT_ID=

# Buckets criados por supabase/schema.sql
MESTRE_STORAGE_BUCKET=mestre-public-assets
MESTRE_PRIVATE_BUCKET=mestre-private-media

# Origens autorizadas a chamar a Edge Function.
# Inclua localhost, o esquema Capacitor e o domínio HTTPS onde o PWA será publicado.
ALLOWED_ORIGINS=http://localhost,http://localhost:5173,http://localhost:4173,capacitor://localhost,https://SEU_DOMINIO

# NÃO coloque SUPABASE_SECRET_KEYS/SUPABASE_SERVICE_ROLE_KEY no frontend.
# No ambiente hospedado, as chaves privilegiadas ficam somente na Edge Function.
